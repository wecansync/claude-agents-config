#!/usr/bin/env python3
"""Static and installed-tree checks for the portable Claude fleet bundle."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

MARKER = "claude-agents-config:"
GENERATED_MARKER = "GENERATED BY claude-fleet-sync"
SECRET_PATTERNS = [
    re.compile(r"sk-[A-Za-z0-9_-]{12,}"),
    re.compile(r"gh[pousr]_[A-Za-z0-9]{12,}"),
    re.compile(r"xox[baprs]-[A-Za-z0-9-]{12,}"),
    re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    re.compile(r"AKIA[0-9A-Z]{12,}"),
    re.compile("-----BEGIN " + r"(?:RSA |EC |OPENSSH )?PRIVATE KEY" + "-----"),
]


def fail(errors: list[str], message: str) -> None:
    errors.append(message)


def resolve_dir(value: str | None) -> Path:
    path = Path(value).expanduser() if value else Path.cwd()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve(strict=False)


def target_home(args: argparse.Namespace) -> Path:
    if args.home:
        return resolve_dir(args.home)
    if args.prefix:
        return resolve_dir(args.prefix)
    return resolve_dir(os.environ.get("HOME", ""))


def target_bin(args: argparse.Namespace, home: Path) -> Path:
    return resolve_dir(args.prefix) / "bin" if args.prefix else home / ".local" / "bin"


def read_json(path: Path, errors: list[str], label: str) -> dict | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(errors, f"missing {label}: {path}")
        return None
    except (OSError, json.JSONDecodeError) as exc:
        fail(errors, f"invalid JSON for {label} ({path}): {exc}")
        return None
    if not isinstance(value, dict):
        fail(errors, f"{label} must be a JSON object: {path}")
        return None
    return value


def frontmatter(text: str) -> dict[str, str] | None:
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    result: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        result[key.strip()] = value.strip().strip('"')
    return result


def scan_bundle(bundle: Path, errors: list[str]) -> None:
    manifest_path = bundle / "manifest.json"
    manifest = read_json(manifest_path, errors, "bundle manifest")
    if manifest is None:
        return
    version_path = bundle / "VERSION"
    if not version_path.is_file():
        fail(errors, f"missing VERSION: {version_path}")
    files = manifest.get("files")
    if not isinstance(files, list) or not files:
        fail(errors, "manifest.files is empty or invalid")
    else:
        for item in files:
            if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not isinstance(item.get("sha256"), str):
                fail(errors, "manifest contains an invalid file record")
                continue
            path = bundle / item["path"]
            if not path.is_file():
                fail(errors, f"manifest file is missing: {path}")
                continue
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            if digest != item["sha256"]:
                fail(errors, f"checksum mismatch: {path}")
    for path in bundle.rglob("*"):
        if not path.is_file() or path.name in {"manifest.json", "checksums.sha256"}:
            continue
        try:
            data = path.read_bytes()
            text = data.decode("utf-8", errors="ignore")
        except OSError as exc:
            fail(errors, f"cannot scan {path}: {exc}")
            continue
        if "/home/" in text and "claude-agents-config" not in text:
            fail(errors, f"non-portable home path in bundle: {path}")
        for pattern in SECRET_PATTERNS:
            if pattern.search(text):
                fail(errors, f"credential-shaped value in bundle: {path}")
                break
    template = read_json(bundle / "config/settings.template.json", errors, "settings template")
    fleet = read_json(bundle / "config/delegate-fleet.json", errors, "fleet configuration")
    if template is not None and fleet is not None:
        validate_fleet_and_picker(fleet, template, errors, "bundle")
    route = bundle / "scripts/route-to-fleet.py"
    if route.is_file():
        text = route.read_text(encoding="utf-8")
        for needle in ("0o600", "PROMPT_RETENTION_DAYS = 14", "ENTRY_RETENTION_DAYS = 90", "LOG_MAX_BYTES = 2_000_000", 'reason == "no-match"'):
            if needle not in text:
                fail(errors, f"routing privacy policy missing {needle}: {route}")
        if 'entry["prompt"]' in text and 'reason == "no-match"' not in text:
            fail(errors, f"routing hook may log prompt text without no-match guard: {route}")


def validate_fleet_and_picker(fleet: dict, settings: dict, errors: list[str], label: str) -> None:
    if fleet.get("version") != "delegate-fleet.v1" or not isinstance(fleet.get("lanes"), dict):
        fail(errors, f"{label} fleet is not delegate-fleet.v1")
        return
    options = settings.get("modelPicker", {}).get("options") if isinstance(settings.get("modelPicker"), dict) else None
    option_ids = {item.get("model") for item in options or [] if isinstance(item, dict)}
    if not option_ids:
        fail(errors, f"{label} settings has no modelPicker options")
    if settings.get("model") and settings.get("model") not in option_ids:
        fail(errors, f"{label} active model is absent from modelPicker")
    lane_names = set()
    for lane, config in fleet["lanes"].items():
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", lane):
            fail(errors, f"{label} invalid lane name: {lane}")
        if not isinstance(config, dict) or config.get("implementer") != "claude":
            fail(errors, f"{label} lane {lane} must use the Claude implementer")
        model = config.get("model") if isinstance(config, dict) else None
        if not model or model not in option_ids:
            fail(errors, f"{label} lane {lane} model is absent from modelPicker")
        lane_names.add(lane)
    if len(lane_names) != 29:
        fail(errors, f"{label} expected 29 lanes, found {len(lane_names)}")


def validate_agents(home: Path, fleet: dict, errors: list[str]) -> None:
    agents_dir = home / ".claude" / "agents"
    lanes = fleet.get("lanes", {}) if isinstance(fleet, dict) else {}
    files = sorted(agents_dir.glob("fleet-*.md")) if agents_dir.is_dir() else []
    if len(files) != len(lanes):
        fail(errors, f"generated-agent count mismatch: expected {len(lanes)}, found {len(files)}")
    for lane, config in lanes.items():
        path = agents_dir / f"fleet-{lane}.md"
        if not path.is_file():
            fail(errors, f"missing generated agent: {path}")
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        fm = frontmatter(text)
        if fm is None:
            fail(errors, f"invalid agent frontmatter: {path}")
            continue
        if fm.get("name") != f"fleet-{lane}" or fm.get("model") != str(config.get("model")):
            fail(errors, f"agent metadata does not match fleet lane: {path}")
        if fm.get("omitClaudeMd") != "true":
            fail(errors, f"agent must omit CLAUDE.md: {path}")
        if GENERATED_MARKER not in text:
            fail(errors, f"agent is not generator-owned: {path}")
        tools = fm.get("tools", "")
        if lane == "research-web" and not all(token in tools for token in ("WebSearch", "WebFetch")):
            fail(errors, f"research-web lacks WebSearch/WebFetch: {path}")
        if lane == "research-codebase" and any(token in tools for token in ("WebSearch", "WebFetch")):
            fail(errors, f"research-codebase has web tools: {path}")


def executable(path: Path, errors: list[str]) -> None:
    if not path.is_file():
        fail(errors, f"missing executable: {path}")
    elif not os.access(path, os.X_OK):
        fail(errors, f"not executable: {path}")


def check_target(bundle: Path, home: Path, bin_dir: Path, errors: list[str]) -> None:
    settings_path = home / ".claude" / "settings.json"
    fleet_path = home / ".config" / "delegate-skills" / "config.json"
    settings = read_json(settings_path, errors, "installed settings")
    fleet = read_json(fleet_path, errors, "installed fleet")
    if settings is not None and fleet is not None:
        validate_fleet_and_picker(fleet, settings, errors, "installed")
        env = settings.get("env")
        if isinstance(env, dict) and env.get("ANTHROPIC_BASE_URL") and not env.get("ANTHROPIC_AUTH_TOKEN"):
            fail(errors, "installed settings enable a gateway URL without a token")
        if isinstance(env, dict) and env.get("ANTHROPIC_BASE_URL"):
            try:
                from urllib.parse import urlparse
                parsed = urlparse(str(env["ANTHROPIC_BASE_URL"]))
                if parsed.username or parsed.password:
                    fail(errors, "installed gateway URL contains embedded credentials")
            except ValueError:
                fail(errors, "installed gateway URL is malformed")
        validate_agents(home, fleet, errors)
    for path in (
        home / ".claude" / "route-to-fleet.py",
        home / ".claude" / "subagent-statusline.py",
        home / ".claude" / "sync-omniroute-models.mjs",
        home / ".config" / "delegate-skills" / "generate-claude-agents.mjs",
        bin_dir / "claude-fleet-sync", bin_dir / "claude-agents-doctor",
    ):
        executable(path, errors)
    route = home / ".claude" / "route-to-fleet.py"
    if route.is_file():
        text = route.read_text(encoding="utf-8", errors="replace")
        for needle in ("0o600", "PROMPT_RETENTION_DAYS = 14", "ENTRY_RETENTION_DAYS = 90", "LOG_MAX_BYTES = 2_000_000"):
            if needle not in text:
                fail(errors, f"installed routing hook missing privacy policy {needle}")
    generator = home / ".config" / "delegate-skills" / "generate-claude-agents.mjs"
    if generator.is_file():
        result = subprocess.run(["node", str(generator), "--check", "--home", str(home), "--quiet"], text=True, capture_output=True)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().splitlines()[-1:]
            fail(errors, "generated-agent sync check failed" + (": " + detail[0] if detail else ""))
    # Installed managed files must remain free of source-machine paths and credential-shaped literals.
    for path in [home / ".claude" / "CLAUDE.md", home / ".claude" / "route-to-fleet.py", home / ".claude" / "subagent-statusline.py", home / ".claude" / "sync-omniroute-models.mjs", generator, fleet_path, *sorted((home / ".claude" / "agents").glob("fleet-*.md"))]:
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8", errors="ignore")
        if "/home/" in text and "claude-agents-config" not in text:
            fail(errors, f"source-machine path in installed file: {path}")
        if any(pattern.search(text) for pattern in SECRET_PATTERNS):
            fail(errors, f"credential-shaped value in installed file: {path}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Check the portable Claude fleet bundle and installation")
    parser.add_argument("--check", action="store_true", help="run checks")
    parser.add_argument("--home", help="target home")
    parser.add_argument("--prefix", help="target prefix")
    parser.add_argument("--bundle", help="bundle root; defaults to this bundle")
    args = parser.parse_args()
    bundle = resolve_dir(args.bundle) if args.bundle else Path(__file__).resolve().parent.parent
    home = target_home(args)
    bin_dir = target_bin(args, home)
    errors: list[str] = []
    if not args.check:
        parser.error("--check is required")
    scan_bundle(bundle, errors)
    check_target(bundle, home, bin_dir, errors)
    if errors:
        print(f"claude-agents-doctor: FAIL ({len(errors)} issue(s))", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        return 1
    print(f"claude-agents-doctor: PASS (bundle={bundle}; home={home}; lanes=29)")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
