#!/usr/bin/env python3
"""Validate a Claude fleet bundle or an installed tree without the source clone."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
sys.dont_write_bytecode = True
import urllib.parse

# Windows pipes and consoles default to a legacy encoding while checked paths
# and model names may contain non-ASCII text; emit stdout as UTF-8.
try:
    sys.stdout.reconfigure(encoding="utf-8")
except Exception:
    pass

MARKER = "claude-agents-config:"
GENERATED_MARKER = "GENERATED BY claude-fleet-sync"
# Claude Code's own aliases (resolved against the user's login) plus the
# claude-* ids older bundle versions wrote for direct installs.
NATIVE_MODELS = {"default", "opus", "sonnet", "haiku"}
FIRST_PARTY_MODELS = NATIVE_MODELS | {"claude-opus-5[1m]", "claude-sonnet-5[1m]", "claude-haiku"}


def is_first_party(model: object) -> bool:
    return isinstance(model, str) and (model in FIRST_PARTY_MODELS or model.removesuffix("[1m]") in NATIVE_MODELS)
SECRET_PATTERNS = [
    re.compile(r"sk-[A-Za-z0-9_-]{12,}"),
    re.compile(r"gh[pousr]_[A-Za-z0-9]{12,}"),
    re.compile(r"xox[baprs]-[A-Za-z0-9-]{12,}"),
    re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    re.compile(r"AKIA[0-9A-Z]{12,}"),
    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
]
FORBIDDEN_SOURCE_STRINGS = (
    "/" + "home/sync2",
    "/" + "mnt/html",
    "/" + "var/www/html/" + "claude-agents-config",
)
# Lanes that must never get write or nested-agent tools, whatever the fleet
# map says; any other lane marked readOnly is held to the same rule.
STATIC_ROLES = {
    "plan", "plan-alt", "review", "review-alt", "review-deep", "diagnose-static", "security-review",
    "research-codebase", "research-web", "explore-narrow", "triage-static",
}
AUTO_COMPACT_WINDOW = 800000
AUTO_COMPACT_MIN = 100000
AUTO_COMPACT_MAX = 1000000


def fail(errors: list[str], message: str) -> None:
    errors.append(message)


def candidate_models(config: object) -> list[str]:
    if not isinstance(config, dict):
        return []
    fallbacks = config.get("fallbacks") if isinstance(config.get("fallbacks"), list) else []
    return [model for model in [config.get("model"), *fallbacks] if isinstance(model, str) and model]


def resolve_dir(value: str | None) -> Path:
    path = Path(value).expanduser() if value else Path.cwd()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve(strict=False)


def home_for(args: argparse.Namespace) -> Path:
    if args.home:
        return resolve_dir(args.home)
    if args.prefix:
        return resolve_dir(args.prefix)
    if os.name == "nt":
        raw = os.environ.get("USERPROFILE") or (os.environ.get("HOMEDRIVE", "") + os.environ.get("HOMEPATH", "")) or os.environ.get("HOME")
    else:
        raw = os.environ.get("HOME") or os.environ.get("USERPROFILE") or (os.environ.get("HOMEDRIVE", "") + os.environ.get("HOMEPATH", ""))
    return resolve_dir(raw) if raw else Path.home().resolve(strict=False)


def config_home_for(args: argparse.Namespace, home: Path) -> Path:
    if args.config_home:
        return resolve_dir(args.config_home)
    if args.prefix and not args.home:
        return resolve_dir(args.prefix) / ".config"
    return resolve_dir(os.environ["XDG_CONFIG_HOME"]) if os.environ.get("XDG_CONFIG_HOME") else home / ".config"


def bin_for(args: argparse.Namespace, home: Path) -> Path:
    return resolve_dir(args.prefix) / "bin" if args.prefix else home / ".local" / "bin"


def read_json(path: Path, errors: list[str], label: str) -> dict | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(errors, f"missing {label}: {path}")
        return None
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(errors, f"invalid JSON for {label} ({path}): {exc}")
        return None
    if not isinstance(value, dict):
        fail(errors, f"{label} must be a JSON object: {path}")
        return None
    return value


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate_rel(value: object, label: str, errors: list[str]) -> str | None:
    if not isinstance(value, str) or not value or "\\" in value:
        fail(errors, f"{label} contains an invalid relative path: {value!r}")
        return None
    path = Path(value)
    if path.is_absolute() or ".." in path.parts or value in {"", "."}:
        fail(errors, f"{label} contains an unsafe path: {value!r}")
        return None
    return value


def manifest_records(manifest: dict, errors: list[str], label: str) -> dict[str, dict]:
    records = manifest.get("files")
    if not isinstance(records, list) or not records:
        fail(errors, f"{label}.files is empty or invalid")
        return {}
    result = {}
    for item in records:
        if not isinstance(item, dict):
            fail(errors, f"{label} contains a non-object file record")
            continue
        rel = validate_rel(item.get("path"), label, errors)
        digest = item.get("sha256")
        mode = item.get("mode")
        if rel is None:
            continue
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            fail(errors, f"{label} has an invalid checksum for {rel}")
        if mode not in {"0o644", "0o755"}:
            fail(errors, f"{label} mode for {rel} is not logical 0o644/0o755")
        if rel in result:
            fail(errors, f"{label} lists {rel} more than once")
        result[rel] = item
    return result


def source_bundle(bundle: Path, errors: list[str]) -> dict | None:
    manifest = read_json(bundle / "manifest.json", errors, "bundle manifest")
    if manifest is None:
        return None
    if manifest.get("format") != "claude-agents-config.bundle.v1":
        fail(errors, "bundle manifest has an invalid format marker")
    version_path = bundle / "VERSION"
    if not version_path.is_file():
        fail(errors, f"missing VERSION: {version_path}")
    else:
        version = version_path.read_text(encoding="utf-8").strip()
        if version != manifest.get("version"):
            fail(errors, "VERSION does not equal manifest.version")
    records = manifest_records(manifest, errors, "manifest")
    for rel, item in records.items():
        path = bundle / rel
        if not path.is_file() or path.is_symlink():
            fail(errors, f"manifest file is missing or not regular: {path}")
            continue
        if sha256(path) != item.get("sha256"):
            fail(errors, f"checksum mismatch: {path}")
        if os.name != "nt":
            expected_mode = {"0o755": 0o755, "0o644": 0o644}.get(item.get("mode"))
            actual_mode = stat.S_IMODE(path.stat().st_mode)
            if expected_mode is None or actual_mode != expected_mode:
                fail(errors, f"mode mismatch for {path}: expected {item.get('mode')}, found {oct(actual_mode)}")
    checksum_path = bundle / "checksums.sha256"
    checksums = {}
    if not checksum_path.is_file():
        fail(errors, f"missing checksums.sha256: {checksum_path}")
    else:
        for line_number, line in enumerate(checksum_path.read_text(encoding="utf-8").splitlines(), 1):
            if not line:
                continue
            match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
            if not match:
                fail(errors, f"invalid checksums.sha256 line {line_number}")
                continue
            digest, rel = match.groups()
            rel = validate_rel(rel, "checksums.sha256", errors)
            if rel:
                checksums[rel] = digest
    if checksums != {rel: item.get("sha256") for rel, item in records.items()}:
        fail(errors, "checksums.sha256 does not have exact parity with manifest.json")
    actual = set()
    for path in bundle.rglob("*"):
        relative_parts = path.relative_to(bundle).parts
        if ".git" in path.parts or (relative_parts and relative_parts[0] in {".ai", ".claude", ".commandcode", ".kilo", ".github", "site", "packaging", "dist"}):
            continue
        if path.is_dir():
            if path.name == "__pycache__":
                fail(errors, f"generated __pycache__ is present: {path}")
            continue
        rel = path.relative_to(bundle).as_posix()
        if rel not in {"manifest.json", "checksums.sha256"}:
            actual.add(rel)
    if actual != set(records):
        fail(errors, "bundle inventory differs from manifest: " + ", ".join(sorted(actual ^ set(records))))
    for rel in records:
        path = bundle / rel
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            fail(errors, f"cannot scan bundle file {path}: {exc}")
            continue
        if any(value in text for value in FORBIDDEN_SOURCE_STRINGS):
            fail(errors, f"forbidden machine-local path in bundle: {path}")
        if any(pattern.search(text) for pattern in SECRET_PATTERNS):
            fail(errors, f"credential-shaped value in bundle: {path}")
    route = bundle / "scripts/route-to-fleet.py"
    if route.is_file():
        try:
            route_text = route.read_text(encoding="utf-8")
            for needle in ("0o600", "PROMPT_RETENTION_DAYS = 14", "ENTRY_RETENTION_DAYS = 90", "LOG_MAX_BYTES = 2_000_000", 'reason == "no-match"'):
                if needle not in route_text:
                    fail(errors, f"routing privacy policy missing {needle}: {route}")
        except (OSError, UnicodeError) as exc:
            fail(errors, f"cannot read routing hook {route}: {exc}")

    template = read_json(bundle / "config/settings.template.json", errors, "settings template")
    fleet = read_json(bundle / "config/delegate-fleet.json", errors, "fleet configuration")
    if template is not None:
        template_env = template.get("env") if isinstance(template.get("env"), dict) else {}
        if template.get("autoCompactWindow") != AUTO_COMPACT_WINDOW or template_env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW") != str(AUTO_COMPACT_WINDOW):
            fail(errors, f"settings template must compact at {AUTO_COMPACT_WINDOW} tokens")
    if template is not None and fleet is not None:
        validate_fleet_and_picker(fleet, template, errors, "bundle")
    return manifest


def frontmatter(text: str) -> dict[str, str] | None:
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    result = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        result[key.strip()] = value.strip().strip('"')
    return result


def validate_fleet_and_picker(fleet: dict, settings: dict, errors: list[str], label: str, profile: str | None = None) -> None:
    if fleet.get("version") != "delegate-fleet.v1" or not isinstance(fleet.get("lanes"), dict):
        fail(errors, f"{label} fleet is not delegate-fleet.v1")
        return
    expected_lane_count = len(fleet["lanes"])
    if expected_lane_count < 1:
        fail(errors, f"{label} fleet has no lanes")
    picker = settings.get("modelPicker") if isinstance(settings.get("modelPicker"), dict) else {}
    options = picker.get("options") if isinstance(picker.get("options"), list) else []
    option_ids = {item.get("model") for item in options if isinstance(item, dict)}
    if not option_ids:
        fail(errors, f"{label} settings has no modelPicker options")
    active = settings.get("model")
    if active and active not in option_ids:
        fail(errors, f"{label} active model is absent from modelPicker")
    if profile == "direct-anthropic":
        installed_env = settings.get("env")
        gateway_configured = isinstance(installed_env, dict) and bool(installed_env.get("ANTHROPIC_BASE_URL")) and bool(installed_env.get("ANTHROPIC_AUTH_TOKEN"))
        # First-party enforcement applies only to a pure direct setup. A user
        # configured gateway URL and token make gateway model IDs intentional.
        if not gateway_configured:
            if active and not is_first_party(active):
                fail(errors, f"direct profile active model is not first-party Claude: {active}")
            if settings.get("advisorModel") and not is_first_party(settings.get("advisorModel")):
                fail(errors, f"direct profile advisor model is not first-party Claude: {settings.get('advisorModel')}")
            if any(not is_first_party(model) for model in option_ids if model in {c.get("model") for c in fleet["lanes"].values() if isinstance(c, dict)}):
                fail(errors, "direct profile fleet contains a non-first-party model")
    for lane, config in fleet["lanes"].items():
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", lane):
            fail(errors, f"{label} invalid lane name: {lane}")
        if not isinstance(config, dict) or config.get("implementer") != "claude":
            fail(errors, f"{label} lane {lane} must use the Claude implementer")
            continue
        candidates = candidate_models(config)
        if not candidates or not any(model in option_ids for model in candidates):
            fail(errors, f"{label} lane {lane} has no model candidate in modelPicker")


def validate_agents(home: Path, config_root: Path, fleet: dict, settings: dict, errors: list[str], profile: str | None) -> None:
    agents_dir = home / ".claude" / "agents"
    picker = settings.get("modelPicker") if isinstance(settings.get("modelPicker"), dict) else {}
    options = picker.get("options") if isinstance(picker.get("options"), list) else []
    option_ids = {item.get("model") for item in options if isinstance(item, dict)}
    lanes = fleet.get("lanes", {}) if isinstance(fleet, dict) else {}
    files = sorted(agents_dir.glob("fleet-*.md")) if agents_dir.is_dir() else []
    if len(files) != len(lanes):
        fail(errors, f"generated-agent count mismatch: expected {len(lanes)}, found {len(files)}")
    claude_fleet = home / ".claude" / "fleet.json"
    legacy_fleet = config_root / "delegate-skills" / "config.json"
    fleet_path = claude_fleet if claude_fleet.is_file() else legacy_fleet
    fleet_hash = sha256(fleet_path)[:16] if fleet_path.is_file() else ""
    # The installer hashes the exact bytes it writes.  Normalize equivalent JSON
    # only for legacy trees; current trees use the bytes hash checked below.
    for lane, config in lanes.items():
        path = agents_dir / f"fleet-{lane}.md"
        if not path.is_file():
            fail(errors, f"missing generated agent: {path}")
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        fm = frontmatter(text)
        if fm is None:
            fail(errors, f"invalid agent frontmatter: {path}")
            continue
        candidates = candidate_models(config)
        if fm.get("name") != f"fleet-{lane}" or fm.get("model") not in candidates or fm.get("model") not in option_ids:
            fail(errors, f"agent metadata does not match fleet candidates: {path}")
        if fm.get("omitClaudeMd") != "true":
            fail(errors, f"agent must omit CLAUDE.md: {path}")
        if GENERATED_MARKER not in text:
            fail(errors, f"agent is not generator-owned: {path}")
        tools = {part.strip() for part in fm.get("tools", "").split(",")}
        if (lane in STATIC_ROLES or (isinstance(config, dict) and config.get("readOnly") is True)) and tools.intersection({"Bash", "Edit", "Write", "Agent"}):
            fail(errors, f"static lane has write or nested-agent tools: {path}")
        if lane == "research-web" and not {"WebSearch", "WebFetch"}.issubset(tools):
            fail(errors, f"research-web lacks WebSearch/WebFetch: {path}")
        if lane == "research-codebase" and tools.intersection({"WebSearch", "WebFetch"}):
            fail(errors, f"research-codebase has web tools: {path}")


def installed_manifest(home: Path, errors: list[str]) -> dict | None:
    path = home / ".claude" / ".claude-agents-config-manifest.json"
    value = read_json(path, errors, "installed verification manifest")
    if value is None:
        return None
    if value.get("format") != "claude-agents-config.installed.v1" or value.get("marker") != MARKER:
        fail(errors, f"invalid installed verification manifest: {path}")
    if not isinstance(value.get("version"), str) or not value.get("version"):
        fail(errors, f"installed verification manifest has no version: {path}")
    if value.get("profile") not in {"direct-anthropic", "gateway"}:
        fail(errors, f"installed verification manifest has invalid profile: {path}")
    fleet_digest = value.get("fleetSha256")
    if not isinstance(fleet_digest, str) or not re.fullmatch(r"[0-9a-f]{64}", fleet_digest):
        fail(errors, f"installed verification manifest has invalid fleetSha256: {path}")
    return value


def check_installed_records(home: Path, config_root: Path, bin_dir: Path, errors: list[str], manifest: dict | None) -> None:
    if manifest is None:
        return
    records = manifest.get("managed")
    if not isinstance(records, list) or not records:
        fail(errors, "installed verification manifest has no managed records")
        return
    roots = [home.resolve(strict=False), config_root.resolve(strict=False), bin_dir.resolve(strict=False)]
    seen_ids: set[str] = set()
    seen_paths: set[str] = set()
    for item in records:
        if not isinstance(item, dict):
            fail(errors, "installed verification manifest has an invalid record")
            continue
        ident = item.get("id")
        raw_path = item.get("path")
        digest = item.get("sha256")
        mode = item.get("mode")
        if not isinstance(ident, str) or not ident or ident in seen_ids:
            fail(errors, f"installed verification manifest has an empty or duplicate record id: {ident!r}")
        elif ident:
            seen_ids.add(ident)
        if not isinstance(raw_path, str) or not raw_path or raw_path in seen_paths:
            fail(errors, f"installed verification manifest has an empty or duplicate path: {raw_path!r}")
        elif raw_path:
            seen_paths.add(raw_path)
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            fail(errors, f"installed verification manifest has an invalid checksum: {raw_path!r}")
        if mode not in {"0o755", "0o644", "0o600"}:
            fail(errors, f"installed verification manifest has an invalid mode for {raw_path!r}: {mode!r}")
        if not isinstance(raw_path, str):
            continue
        path = Path(raw_path)
        resolved = path.resolve(strict=False)
        if not path.is_absolute() or not any(resolved == root or root in resolved.parents for root in roots):
            fail(errors, f"installed manifest path escapes target roots: {path}")
            continue
        if path.is_symlink():
            fail(errors, f"installed managed file is a symlink: {path}")
            continue
        if not path.is_file():
            fail(errors, f"installed managed file is missing: {path}")
            continue
        # settings.json and provider-policy.json are intentionally mutable:
        # users may edit settings or run claude-fleet-setup to approve families,
        # and the discovery hook may refresh the model picker at SessionStart.
        # Their schema and invariants are checked below instead of treating
        # expected user configuration changes as tampering.
        if ident not in {"home:.claude/settings.json", "config:provider-policy.json"} and digest != sha256(path):
            fail(errors, f"installed managed checksum mismatch: {path}")
        if os.name != "nt":
            expected_mode = {"0o755": 0o755, "0o644": 0o644, "0o600": 0o600}.get(mode)
            actual_mode = stat.S_IMODE(path.stat().st_mode)
            if expected_mode is None or actual_mode != expected_mode:
                fail(errors, f"installed mode mismatch: {path} expected {mode}, found {oct(actual_mode)}")


def check_target(home: Path, config_root: Path, bin_dir: Path, errors: list[str], profile: str | None) -> None:
    manifest = installed_manifest(home, errors)
    check_installed_records(home, config_root, bin_dir, errors, manifest)
    settings_path = home / ".claude" / "settings.json"
    claude_fleet = home / ".claude" / "fleet.json"
    legacy_fleet = config_root / "delegate-skills" / "config.json"
    fleet_path = claude_fleet if claude_fleet.is_file() else legacy_fleet
    settings = read_json(settings_path, errors, "installed settings")
    fleet = read_json(fleet_path, errors, "installed fleet")
    metadata = read_json(home / ".claude" / ".claude-agents-config-install.json", errors, "installed metadata")
    if manifest is not None and metadata is None:
        fail(errors, "installed metadata is required when a verification manifest exists")
    if metadata is not None:
        if metadata.get("marker") != MARKER or not isinstance(metadata.get("version"), str) or not metadata.get("version"):
            fail(errors, "installed metadata has an invalid marker or version")
        if metadata.get("profile") not in {"direct-anthropic", "gateway"}:
            fail(errors, "installed metadata has an invalid profile")
        if manifest is not None and metadata.get("version") != manifest.get("version"):
            fail(errors, "installed metadata version does not match verification manifest")
        meta_records = metadata.get("managed")
        manifest_records = manifest.get("managed") if manifest is not None else None
        if not isinstance(meta_records, list) or not meta_records:
            fail(errors, "installed metadata has no managed records")
        if not isinstance(manifest_records, list) or not manifest_records:
            fail(errors, "installed verification manifest has no managed records")
        else:
            meta_ids = [item.get("id") for item in meta_records if isinstance(item, dict)] if isinstance(meta_records, list) else []
            manifest_ids = [item.get("id") for item in manifest_records if isinstance(item, dict)]
            if len(meta_ids) != len(set(meta_ids)) or any(not isinstance(item, str) or not item for item in meta_ids):
                fail(errors, "installed metadata has empty or duplicate managed IDs")
            if meta_ids != manifest_ids:
                fail(errors, "installed metadata and verification manifest IDs differ")
            meta_paths = [item.get("path") for item in meta_records if isinstance(item, dict)] if isinstance(meta_records, list) else []
            manifest_paths = [item.get("path") for item in manifest_records if isinstance(item, dict)]
            if len(meta_paths) != len(set(meta_paths)) or any(not isinstance(item, str) or not item for item in meta_paths):
                fail(errors, "installed metadata has empty or duplicate managed paths")
            if meta_paths != manifest_paths:
                fail(errors, "installed metadata and verification manifest paths differ")
            verification_path = home / ".claude" / ".claude-agents-config-manifest.json"
            verification_digest = metadata.get("verificationSha256")
            if not isinstance(verification_digest, str) or not re.fullmatch(r"[0-9a-f]{64}", verification_digest) or verification_digest != sha256(verification_path):
                fail(errors, "installed metadata does not verify the installed verification manifest digest")
    # The live settings decide the profile: 'agentfleet use' switches between
    # gateway and direct without reinstalling, so install-time metadata can be
    # stale. Credentials present means gateway; otherwise direct Anthropic.
    live_env = settings.get("env") if isinstance(settings, dict) and isinstance(settings.get("env"), dict) else {}
    inferred = "gateway" if live_env.get("ANTHROPIC_BASE_URL") and live_env.get("ANTHROPIC_AUTH_TOKEN") else ("direct-anthropic" if metadata else None)
    effective_profile = profile or inferred
    if settings is not None and fleet is not None:
        validate_fleet_and_picker(fleet, settings, errors, "installed", effective_profile)
        env = settings.get("env")
        compact_window = settings.get("autoCompactWindow")
        compact_env = env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW") if isinstance(env, dict) else None
        try:
            compact_env_number = int(compact_env) if compact_env is not None else None
        except (TypeError, ValueError):
            compact_env_number = None
        if not isinstance(compact_window, int) or not AUTO_COMPACT_MIN <= compact_window <= AUTO_COMPACT_MAX:
            fail(errors, f"installed autoCompactWindow must be an integer from {AUTO_COMPACT_MIN} to {AUTO_COMPACT_MAX}: {compact_window}")
        if compact_env_number is None or not AUTO_COMPACT_MIN <= compact_env_number <= AUTO_COMPACT_MAX:
            fail(errors, f"installed CLAUDE_CODE_AUTO_COMPACT_WINDOW must be a plain token count from {AUTO_COMPACT_MIN} to {AUTO_COMPACT_MAX}")
        if isinstance(compact_window, int) and compact_env_number is not None and compact_window != compact_env_number:
            fail(errors, "installed autoCompactWindow and CLAUDE_CODE_AUTO_COMPACT_WINDOW must match")
        if isinstance(env, dict) and env.get("ANTHROPIC_BASE_URL"):
            try:
                parsed = urllib.parse.urlparse(str(env["ANTHROPIC_BASE_URL"]))
                if parsed.username or parsed.password or parsed.scheme not in {"http", "https"} or not parsed.hostname:
                    fail(errors, "installed gateway URL is malformed or contains embedded credentials")
                if parsed.scheme == "http" and parsed.hostname.lower() not in {"localhost", "127.0.0.1", "::1", "[::1]"}:
                    fail(errors, "installed gateway URL uses non-loopback HTTP")
            except ValueError:
                fail(errors, "installed gateway URL is malformed")
            if not env.get("ANTHROPIC_AUTH_TOKEN"):
                fail(errors, "installed settings enable a gateway URL without a token")
        gateway_configured = isinstance(env, dict) and bool(env.get("ANTHROPIC_BASE_URL")) and bool(env.get("ANTHROPIC_AUTH_TOKEN"))
        if effective_profile == "direct-anthropic" and not gateway_configured and (not isinstance(env, dict) or env.get("CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY") != "0"):
            fail(errors, "direct profile must disable gateway model discovery")
        validate_agents(home, config_root, fleet, settings, errors, effective_profile)
    policy_path = config_root / "delegate-skills" / "provider-policy.json"
    if policy_path.is_file():
        policy = read_json(policy_path, errors, "installed provider policy")
        if policy is not None:
            provider = policy.get("provider")
            if policy.get("version") != "provider-policy.v1" or not isinstance(provider, str) or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", provider) or not isinstance(policy.get("families"), list):
                fail(errors, f"installed provider policy is invalid: {policy_path}")
    expected = [
        home / ".claude" / "route-to-fleet.py",
        home / ".claude" / "subagent-statusline.py",
        home / ".claude" / "sync-provider-models.mjs",
        home / ".claude" / "fleet-model-drift.py",
        home / ".claude" / "sync-model-context.py",
        home / ".claude" / "provider_catalog.py",
        home / ".claude" / "fleet-reconcile.py",
        home / ".claude" / "claude-fleet-setup.py",
        home / ".claude" / "agentfleet.py",
        config_root / "delegate-skills" / "provider-policy.json",
        config_root / "delegate-skills" / "generate-claude-agents.mjs",
    ]
    for path in expected:
        if not path.is_file():
            fail(errors, f"missing installed runtime file: {path}")
    for path in [home / ".claude" / "CLAUDE.md", *expected, home / ".claude" / "provider_catalog.py", home / ".claude" / "fleet-reconcile.py", config_root / "delegate-skills" / "provider-policy.json", fleet_path, *sorted((home / ".claude" / "agents").glob("fleet-*.md"))]:
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8", errors="ignore")
        if any(value in text for value in FORBIDDEN_SOURCE_STRINGS):
            fail(errors, f"source-machine path in installed file: {path}")
        if any(pattern.search(text) for pattern in SECRET_PATTERNS):
            fail(errors, f"credential-shaped value in installed file: {path}")
    if manifest is not None and fleet_path.is_file():
        expected_fleet_hash = manifest.get("fleetSha256")
        if expected_fleet_hash and sha256(fleet_path) != expected_fleet_hash:
            fail(errors, "installed fleet checksum does not match verification manifest")
        fleet_hash = sha256(fleet_path)[:16]
        for path in sorted((home / ".claude" / "agents").glob("fleet-*.md")):
            text = path.read_text(encoding="utf-8", errors="replace")
            marker = re.search(r"source-sha256: ([0-9a-f]+)", text)
            if fleet_hash and (not marker or marker.group(1) != fleet_hash):
                fail(errors, f"generated marker/source hash mismatch: {path}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Check the portable Claude fleet bundle and installation")
    parser.add_argument("--check", action="store_true", help="run checks")
    parser.add_argument("--home", help="target home")
    parser.add_argument("--prefix", help="target prefix")
    parser.add_argument("--config-home", help="configuration root")
    parser.add_argument("--bundle", help="bundle root; optional when checking an installed tree")
    parser.add_argument("--profile", choices=("direct-anthropic", "gateway"), help="expected installed profile")
    args = parser.parse_args()
    if not args.check:
        parser.error("--check is required")
    errors: list[str] = []
    home = home_for(args)
    config_root = config_home_for(args, home)
    bin_dir = bin_for(args, home)
    bundle = resolve_dir(args.bundle) if args.bundle else Path(__file__).resolve().parent.parent
    if args.bundle or (bundle / "manifest.json").is_file():
        source_bundle(bundle, errors)
    # A source-only check is useful before installation and must not require an
    # unrelated target tree. Installed-tree checks activate when --home/--prefix
    # is explicitly supplied or when the installed verification manifest exists.
    target_requested = bool(args.home or args.prefix or args.config_home)
    if target_requested or (home / ".claude" / ".claude-agents-config-manifest.json").exists():
        check_target(home, config_root, bin_dir, errors, args.profile)
    if errors:
        print(f"claude-agents-doctor: FAIL ({len(errors)} issue(s))", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        return 1
    bundle_text = f"; bundle={bundle}" if (args.bundle or (bundle / "manifest.json").is_file()) else ""
    claude_fleet = home / ".claude" / "fleet.json"
    legacy_fleet = config_root / "delegate-skills" / "config.json"
    fleet_target = claude_fleet if claude_fleet.is_file() else legacy_fleet
    fleet_value = read_json(fleet_target, errors, "fleet") if fleet_target.is_file() else None
    lane_count = len(fleet_value.get("lanes", {})) if isinstance(fleet_value, dict) else 0
    print(f"claude-agents-doctor: PASS (home={home}; config={config_root}; lanes={lane_count}{bundle_text})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
