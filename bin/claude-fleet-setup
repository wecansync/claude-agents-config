#!/usr/bin/env python3
"""Explicit provider/fleet setup interview and noninteractive policy command.

This command may prompt on a TTY. SessionStart hooks must never invoke it;
they report pending decisions and continue with the last approved state.
"""
from __future__ import annotations

import argparse
import getpass
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import sys
import tempfile

# Set before importing provider_catalog: CPython writes a module's .pyc
# during import, before the module body (and its own identical guard) can
# run. Without this, importing it here creates a __pycache__ directory next
# to the managed scripts -- which the installer's own bundle-inventory
# preflight then rejects as an unlisted path, and which leaves stray
# generated files in an installed home.
sys.dont_write_bytecode = True
_HERE = Path(__file__).resolve().parent
SCRIPTS = _HERE if (_HERE / "provider_catalog.py").is_file() else _HERE.parent / "scripts"
sys.path.insert(0, str(SCRIPTS))
from provider_catalog import CatalogError, acquire_lock, load_policy, release_lock  # noqa: E402

# Windows pipes and consoles default to a legacy encoding while policy output
# may quote non-ASCII model names or paths; emit stdout as UTF-8.
try:
    sys.stdout.reconfigure(encoding="utf-8")
except Exception:
    pass


def read_json(path: Path, default: object = None) -> object:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return default


def atomic_json(path: Path, value: object, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, raw = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    temp = Path(raw)
    try:
        data = (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
        os.write(fd, data)
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        if fd >= 0:
            os.close(fd)
        temp.unlink(missing_ok=True)


def ask_yes_no(prompt: str, default: bool = False) -> bool:
    suffix = "Y/n" if default else "y/N"
    answer = input(f"{prompt} [{suffix}] ").strip().lower()
    if not answer:
        return default
    return answer in {"y", "yes"}


def resolved_home(args: argparse.Namespace) -> Path:
    return Path(args.home).expanduser().resolve() if args.home else Path.home().resolve()


def policy_path(args: argparse.Namespace) -> Path:
    if args.policy:
        return Path(args.policy).expanduser().resolve()
    home = resolved_home(args)
    config = Path(args.config_home).expanduser().resolve() if args.config_home else Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")).resolve()
    return config / "delegate-skills" / "provider-policy.json"


def parse_decisions(value: str | None) -> dict:
    if not value:
        return {}
    path = Path(value).expanduser().resolve()
    data = read_json(path)
    if not isinstance(data, dict):
        raise SystemExit(f"decision file is not a JSON object: {path}")
    return data


PROPOSAL_KEYS = {"proposalDecision", "proposalHash", "supersededBy"}
FAMILY_KEYS = {"approvedFamilies", "allowDiscovery"}


def validate_decisions(decisions: dict) -> None:
    """Reject an unsupported or ambiguous decision document before any
    write happens. A decision file is exactly one of a proposal-decision
    document or a family-approval document; it must never mix fields from
    both (that would make it ambiguous which side effect the caller
    intended), and it must never carry an unrecognized key such as the
    since-removed "fallbacks" selection."""
    if decisions.get("format") not in {None, "provider-policy-decisions.v1"}:
        raise SystemExit("unsupported decision file format")
    has_proposal_fields = bool(PROPOSAL_KEYS & decisions.keys())
    has_family_fields = bool(FAMILY_KEYS & decisions.keys())
    if has_proposal_fields and has_family_fields:
        raise SystemExit("decision file mixes proposal-decision fields with family-approval fields; submit them separately")
    allowed = {"format"} | (PROPOSAL_KEYS if has_proposal_fields else FAMILY_KEYS)
    unknown = set(decisions) - allowed
    if unknown:
        raise SystemExit(f"unsupported decision file keys: {sorted(unknown)}")


def interview(policy: dict) -> dict:
    if not sys.stdin.isatty() or not sys.stderr.isatty():
        raise SystemExit("setup interview requires a TTY; pass --decisions FILE for noninteractive use")
    print("Fleet setup interview. New provider families, discovery, and permission choices require explicit approval.")
    approved = []
    for family in policy.get("families", []):
        if not isinstance(family, dict) or not isinstance(family.get("name"), str):
            continue
        if family.get("approved") is True or ask_yes_no(f"Approve automatic reconciliation for family {family['name']}?", False):
            approved.append(family["name"])
    allow_discovery = ask_yes_no("Allow gateway model discovery at SessionStart?", bool(policy.get("discoveryApproved")))
    print("Optional broad permissions/plugins remain disabled by default; configure them separately after review.")
    return {"format": "provider-policy-decisions.v1", "approvedFamilies": approved, "allowDiscovery": allow_discovery}


def proposal_path(home: Path) -> Path:
    """The fleet model proposal always lives under the resolved --home, never
    derived from the policy file's location. An external --config-home,
    XDG_CONFIG_HOME, or a fully custom --policy path must not change where
    the proposal decision is read from or written to."""
    return home / ".claude" / "fleet-model-proposal.json"


def resolve_proposal(home: Path, decisions: dict) -> None:
    proposal_file = proposal_path(home)
    proposal = read_json(proposal_file)
    if not isinstance(proposal, dict) or not proposal.get("models_hash"):
        raise SystemExit("no pending fleet model proposal is available")
    if decisions.get("proposalHash") != proposal.get("models_hash"):
        raise SystemExit("proposalHash must match the current pending proposal")
    action = decisions.get("proposalDecision")
    if action not in {"approve", "reject", "supersede"}:
        raise SystemExit("proposalDecision must be approve, reject, or supersede")
    proposal["decision"] = action
    proposal["decision_at"] = __import__("time").time()
    proposal["superseded_by"] = decisions.get("supersededBy") if action == "supersede" else None
    atomic_json(proposal_file, proposal, 0o600)


def apply_family_decisions(path: Path, decisions: dict, approved: list[str]) -> None:
    """Re-read the policy from disk immediately before validating and
    writing. The caller holds the shared home lock across this call, so a
    concurrent installer or another setup invocation can never have its
    changes silently discarded by a write built from a snapshot loaded
    before -- possibly long-running, interactive -- interview input was
    collected."""
    try:
        latest_policy = load_policy(path)
    except CatalogError as exc:
        raise SystemExit(str(exc))
    for value in approved:
        if not any(isinstance(family, dict) and family.get("name") == value for family in latest_policy.get("families", [])):
            raise SystemExit(f"unknown family requires review before approval: {value}")
    latest_policy["approvedFamilies"] = sorted(set(approved))
    latest_policy["decisionsFormat"] = "provider-policy-decisions.v1"
    approved_set = set(approved)
    for family in latest_policy.get("families", []):
        if isinstance(family, dict) and isinstance(family.get("name"), str):
            family["approved"] = family["name"] in approved_set
    latest_policy["discoveryApproved"] = decisions.get("allowDiscovery") is True
    atomic_json(path, latest_policy, 0o644)


def update_fleet_choices(home: Path, config_home: Path, prefer: list[str], tiers: list[str], lock_timeout: float) -> None:
    """Record explicit lane preferences and model tier labels in both fleet
    mirrors. Reconciliation then applies them against the live catalog."""
    from provider_catalog import TIER_RANK
    mirrors = [home / ".claude" / "fleet.json", config_home / "delegate-skills" / "config.json"]
    present = [path for path in mirrors if path.is_file()]
    if not present:
        raise SystemExit("no fleet map found; install AgentFleet first")
    fd, lock = acquire_lock(home, timeout=lock_timeout)
    if fd is None:
        raise SystemExit(f"another fleet writer holds the lock for {home}; try again")
    try:
        present.sort(key=lambda path: path.stat().st_mtime, reverse=True)
        fleet = read_json(present[0], {})
        lanes = fleet.get("lanes") if isinstance(fleet, dict) else None
        if not isinstance(lanes, dict):
            raise SystemExit(f"{present[0]} has no lanes")
        for item in prefer:
            lane, _, models = item.partition("=")
            lane = lane.strip().removeprefix("fleet-")
            if lane not in lanes:
                raise SystemExit(f"unknown lane: {lane} (lanes: {', '.join(lanes)})")
            values = [model.strip() for model in models.split(",") if model.strip()]
            if values:
                lanes[lane]["preferred"] = values
                lanes[lane]["model"] = values[0]
                print(f"fleet-{lane}: prefers {', '.join(values)}")
            else:
                lanes[lane].pop("preferred", None)
                print(f"fleet-{lane}: preference cleared (ranked by tier)")
        labels = fleet.setdefault("modelTiers", {})
        for item in tiers:
            model, _, tier = item.partition("=")
            model, tier = model.strip(), tier.strip().lower()
            if not model:
                raise SystemExit(f"invalid --tier value: {item}")
            if not tier:
                labels.pop(model, None)
                print(f"{model}: tier label cleared")
            elif tier in TIER_RANK:
                labels[model] = tier
                print(f"{model}: tier {tier}")
            else:
                raise SystemExit(f"invalid tier '{tier}' (use cheap, fast, balanced, or deep)")
        for path in mirrors:
            if path.parent.is_dir():
                atomic_json(path, fleet, 0o644)
    finally:
        release_lock(fd, lock)


def run_setup_reconciliation_and_sync(home: Path, config_home: Path, policy_file: Path) -> None:
    settings_file = home / ".claude" / "settings.json"
    settings = read_json(settings_file, {})
    if not isinstance(settings, dict):
        return

    # Try live fetch if credentials exist
    env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
    endpoint = env.get("ANTHROPIC_BASE_URL")
    token = env.get("ANTHROPIC_AUTH_TOKEN")
    catalog_cache = home / ".claude" / "cache" / "provider-models-cache.json"

    if isinstance(endpoint, str) and isinstance(token, str) and endpoint and token:
        try:
            from provider_catalog import cache_payload, fetch_catalog
            rows, complete, _ = fetch_catalog(endpoint, token, timeout=5.0)
            if complete and isinstance(rows, list):
                try:
                    provider_label = load_policy(policy_file).get("provider", "gateway")
                except CatalogError:
                    provider_label = "gateway"
                payload = cache_payload(rows, endpoint, token, provider=provider_label)
                atomic_json(catalog_cache, payload, 0o600)
        except Exception:
            pass

    reconcile_script = SCRIPTS / "fleet-reconcile.py"
    if not reconcile_script.is_file():
        reconcile_script = home / ".claude" / "fleet-reconcile.py"

    if not reconcile_script.is_file() or not catalog_cache.is_file():
        return

    import subprocess
    cmd = [
        sys.executable,
        str(reconcile_script),
        "--home", str(home),
        "--config-home", str(config_home),
        "--policy", str(policy_file),
        "--catalog", str(catalog_cache),
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if proc.returncode == 0 and proc.stdout:
            try:
                res = json.loads(proc.stdout)
                if res.get("summary"):
                    print(res["summary"])
            except Exception:
                pass
    except OSError:
        pass

    # Synchronize agents
    fleet_sync = home / ".local" / "bin" / "claude-fleet-sync"
    if not fleet_sync.is_file():
        fleet_sync = SCRIPTS / "generate-claude-agents.mjs"
        if not fleet_sync.is_file():
            fleet_sync = home / ".claude" / "generate-claude-agents.mjs"

    if fleet_sync.is_file():
        try:
            if fleet_sync.suffix == ".mjs":
                sync_cmd = ["node", str(fleet_sync), "--home", str(home), "--config-home", str(config_home), "--quiet"]
            else:
                sync_cmd = [str(fleet_sync), "--quiet"]
            proc_sync = subprocess.run(sync_cmd, capture_output=True, text=True, check=False)
            if proc_sync.returncode == 0:
                print("Synchronized fleet agents with approved provider models.")
        except OSError:
            pass


def clean_model_id(model_id: str | None) -> str:
    if not model_id or not isinstance(model_id, str):
        return ""
    return re.sub(r"\[.*?\]$", "", model_id).strip()


def get_live_catalog_info(home: Path) -> dict:
    catalog_cache = home / ".claude" / "cache" / "provider-models-cache.json"
    cache_data = read_json(catalog_cache, {})
    models = []
    if isinstance(cache_data, dict) and isinstance(cache_data.get("models"), list):
        models = cache_data["models"]

    live_ids = set()
    clean_ids = set()
    models_summary = []
    for m in models:
        if isinstance(m, dict) and isinstance(m.get("id"), str):
            mid = m["id"]
            live_ids.add(mid)
            clean = clean_model_id(mid)
            clean_ids.add(clean)
            models_summary.append({
                "id": mid,
                "clean_id": clean,
                "display_name": m.get("display_name", mid),
                "description": m.get("description", ""),
                "context_length": m.get("context_length", 0),
            })
    return {
        "models": models_summary,
        "live_ids": live_ids,
        "clean_ids": clean_ids,
        "cache_file": str(catalog_cache),
        "exists": catalog_cache.is_file(),
    }


def categorize_agent(name: str) -> str:
    stem = name.lower()
    if any(k in stem for k in [
        "database", "mcp", "security", "testing", "accessibility", "compliance",
        "solidity", "incident", "threat", "data-remediation", "onboarding",
        "firmware", "api", "code-reviewer", "code-simplifier", "filament",
        "model-qa", "reality-checker", "evidence-collector", "code-architect",
        "code-explorer"
    ]):
        return "engineering"
    elif any(k in stem for k in [
        "unity", "unreal", "godot", "roblox", "blender", "game", "level-designer",
        "audio", "narrative", "technical-artist", "spatial", "visionos", "xr-"
    ]):
        return "game_dev"
    elif any(k in stem for k in [
        "wechat", "feishu", "china", "tiktok", "e-commerce", "livestream",
        "kuaishou", "bilibili", "xiaohongshu", "zhihu", "douyin", "baidu", "weibo"
    ]):
        return "niche_ops"
    return "other"


def categorize_skill(name: str) -> str:
    if name == "fleet-setup":
        return "core"
    elif name.endswith("-delegate") or name == "delegate-setup":
        return "delegates"
    elif name in [
        "codebase-design", "code-review", "diagnosing-bugs", "domain-modeling",
        "tdd", "resolving-merge-conflicts", "prototype", "research",
        "writing-for-agents", "simplify", "run", "security-review"
    ]:
        return "engineering"
    return "other"


def audit_fleet(home: Path, config_home: Path, policy_file: Path) -> dict:
    catalog_info = get_live_catalog_info(home)
    live_ids = catalog_info["live_ids"]
    clean_ids = catalog_info["clean_ids"]

    settings_file = home / ".claude" / "settings.json"
    settings = read_json(settings_file, {})
    if not isinstance(settings, dict):
        settings = {}

    stale_models = {}
    current_advisor = settings.get("advisorModel")
    if current_advisor:
        if not is_alias(current_advisor) and clean_model_id(current_advisor) not in clean_ids and current_advisor not in live_ids:
            stale_models["advisorModel"] = {"current": current_advisor, "reason": "Not in live provider catalog"}

    current_model = settings.get("model")
    if current_model:
        if not is_alias(current_model) and clean_model_id(current_model) not in clean_ids and current_model not in live_ids:
            stale_models["model"] = {"current": current_model, "reason": "Not in live provider catalog"}

    env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
    for env_key, val in env.items():
        if (env_key in {
            "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL",
            "ANTHROPIC_DEFAULT_HAIKU_MODEL", "ANTHROPIC_SMALL_FAST_MODEL"
        } or env_key.endswith("_MODEL")) and isinstance(val, str):
            if not is_alias(val) and clean_model_id(val) not in clean_ids and val not in live_ids:
                stale_models[f"env.{env_key}"] = {"current": val, "reason": "Not in live provider catalog"}

    compact_window = env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW") or settings.get("autoCompactWindow")
    try:
        compact_int = int(compact_window) if compact_window is not None else 0
    except (ValueError, TypeError):
        compact_int = 0
    compaction_optimal = compact_int >= 800000

    hook_validations = []
    hooks_dict = settings.get("hooks", {})
    if isinstance(hooks_dict, dict):
        for event, entries in hooks_dict.items():
            if isinstance(entries, list):
                for entry in entries:
                    if isinstance(entry, dict) and isinstance(entry.get("hooks"), list):
                        for h in entry["hooks"]:
                            if isinstance(h, dict) and isinstance(h.get("command"), str):
                                cmd = h["command"]
                                clean_cmd = cmd.split("#")[0].strip()
                                parts = shlex.split(clean_cmd) if clean_cmd else []
                                exe = parts[0] if parts else ""
                                script_target = parts[1] if len(parts) > 1 and any(parts[1].endswith(ext) for ext in [".py", ".js", ".mjs", ".sh"]) else None
                                exe_ok = bool((Path(exe).is_file() and os.access(exe, os.X_OK)) or shutil.which(exe))
                                script_ok = bool(Path(script_target).is_file()) if script_target else True
                                is_valid = exe_ok and script_ok
                                error = None
                                if not exe_ok:
                                    error = f"Executable not found or not executable: {exe}"
                                elif not script_ok:
                                    error = f"Script target not found on disk: {script_target}"
                                hook_validations.append({
                                    "event": event,
                                    "command": cmd,
                                    "executable": exe,
                                    "script_target": script_target,
                                    "valid": is_valid,
                                    "error": error
                                })

    statusline = settings.get("subagentStatusLine")
    if isinstance(statusline, dict) and isinstance(statusline.get("command"), str):
        cmd = statusline["command"]
        clean_cmd = cmd.split("#")[0].strip()
        parts = shlex.split(clean_cmd) if clean_cmd else []
        exe = parts[0] if parts else ""
        script_target = parts[1] if len(parts) > 1 and any(parts[1].endswith(ext) for ext in [".py", ".js", ".mjs", ".sh"]) else None
        exe_ok = bool((Path(exe).is_file() and os.access(exe, os.X_OK)) or shutil.which(exe))
        script_ok = bool(Path(script_target).is_file()) if script_target else True
        is_valid = exe_ok and script_ok
        error = None
        if not exe_ok:
            error = f"Executable not found or not executable: {exe}"
        elif not script_ok:
            error = f"Script target not found on disk: {script_target}"
        hook_validations.append({
            "event": "subagentStatusLine",
            "command": cmd,
            "executable": exe,
            "script_target": script_target,
            "valid": is_valid,
            "error": error
        })

    agents_dir = home / ".claude" / "agents"
    fleet_count = 0
    non_fleet_by_cat = {"engineering": [], "game_dev": [], "niche_ops": [], "other": []}
    non_fleet_total_tokens = 0

    if agents_dir.is_dir():
        for f in sorted(agents_dir.glob("*.md")):
            if f.name.startswith("fleet-"):
                fleet_count += 1
            else:
                cat = categorize_agent(f.name)
                try:
                    text = f.read_text(encoding="utf-8")
                    tokens = len(text) // 4
                except OSError:
                    tokens = 0
                non_fleet_total_tokens += tokens
                non_fleet_by_cat.setdefault(cat, []).append({
                    "name": f.name,
                    "category": cat,
                    "est_tokens": tokens
                })

    archived_agents_dir = home / ".claude" / "agents-archived"
    archived_by_cat = {"engineering": 0, "game_dev": 0, "niche_ops": 0, "other": 0}
    archived_total = 0
    if archived_agents_dir.is_dir():
        for f in archived_agents_dir.glob("*.md"):
            cat = categorize_agent(f.name)
            archived_by_cat[cat] = archived_by_cat.get(cat, 0) + 1
            archived_total += 1

    skills_dir = home / ".claude" / "skills"
    skills_by_cat = {"core": [], "delegates": [], "engineering": [], "other": []}
    if skills_dir.is_dir():
        for s in sorted(skills_dir.iterdir()):
            cat = categorize_skill(s.name)
            skills_by_cat.setdefault(cat, []).append(s.name)

    archived_skills_dir = home / ".claude" / "skills-archived"
    archived_skills_count = len(list(archived_skills_dir.iterdir())) if archived_skills_dir.is_dir() else 0

    fleet_config_file = home / ".claude" / "fleet.json"
    if not fleet_config_file.is_file():
        fleet_config_file = config_home / "delegate-skills" / "config.json"
    fleet_config = read_json(fleet_config_file, {})
    lanes = fleet_config.get("lanes", {}) if isinstance(fleet_config, dict) else {}
    assigned_models = set()
    for lane_id, lane_cfg in lanes.items():
        if isinstance(lane_cfg, dict) and lane_cfg.get("model"):
            assigned_models.add(clean_model_id(lane_cfg["model"]))

    utilized_live_models = [m for m in catalog_info["models"] if m["clean_id"] in assigned_models or m["id"] in assigned_models]
    unutilized_live_models = [m for m in catalog_info["models"] if m["clean_id"] not in assigned_models and m["id"] not in assigned_models]

    return {
        "format": "claude-fleet-audit.v1",
        "live_models": {
            "total": len(catalog_info["models"]),
            "models": catalog_info["models"],
            "cache_exists": catalog_info["exists"],
        },
        "settings": {
            "file": str(settings_file),
            "model": current_model,
            "advisor_model": current_advisor,
            "native": not bool(env.get("ANTHROPIC_BASE_URL")),
            "stale_models": stale_models,
            "compaction": {
                "current": compact_window,
                "recommended": 800000,
                "optimal": compaction_optimal
            }
        },
        "hooks": {
            "total": len(hook_validations),
            "all_valid": all(h["valid"] for h in hook_validations) if hook_validations else True,
            "validations": hook_validations
        },
        "agents": {
            "fleet_active_lanes": fleet_count,
            "non_fleet_active_count": sum(len(items) for items in non_fleet_by_cat.values()),
            "non_fleet_est_tokens": non_fleet_total_tokens,
            "non_fleet_by_category": non_fleet_by_cat,
            "archived_total": archived_total,
            "archived_by_category": archived_by_cat
        },
        "skills": {
            "total_active": sum(len(items) for items in skills_by_cat.values()),
            "by_category": skills_by_cat,
            "archived_total": archived_skills_count
        },
        "fleet_coverage": {
            "total_lanes": len(lanes),
            "utilized_live_models_count": len(utilized_live_models),
            "unutilized_live_models_count": len(unutilized_live_models),
            "utilized_models": [m["id"] for m in utilized_live_models],
            "unutilized_models": [m["id"] for m in unutilized_live_models],
            "full_coverage": len(unutilized_live_models) == 0 and len(catalog_info["models"]) > 0
        }
    }


def print_audit_summary(audit: dict) -> None:
    live = audit["live_models"]
    st = audit["settings"]
    hk = audit["hooks"]
    ag = audit["agents"]
    sk = audit["skills"]
    fc = audit["fleet_coverage"]

    print("=== Claude Fleet & Context Audit ===")
    if st.get("native"):
        print("[Models] Native profile: lanes use opus / sonnet / haiku through your Claude login.")
    else:
        print(f"[Live Models] {live['total']} models online in provider catalog.")

    stale = st.get("stale_models", {})
    if stale:
        print("[Settings] Stale models detected:")
        for k, info in stale.items():
            print(f"  - {k}: '{info['current']}' ({info['reason']})")
    else:
        print(f"[Settings] All configured models are valid live models (active model: {st.get('model')}, advisor: {st.get('advisor_model')}).")

    comp = st.get("compaction", {})
    if not comp.get("optimal"):
        print(f"  - Compaction window: {comp.get('current')} (recommend 800000 for 1M context models).")
    else:
        print(f"  - Compaction window: {comp.get('current')} (optimal).")

    if hk.get("all_valid"):
        print(f"[Hooks] {hk.get('total')}/{hk.get('total')} hook commands verified (executables & script targets present on disk).")
    else:
        invalid = [h for h in hk.get("validations", []) if not h.get("valid")]
        print(f"[Hooks] {len(invalid)} hook issue(s) detected:")
        for inv in invalid:
            print(f"  - [{inv.get('event')}] {inv.get('error')}")

    print(f"[Agents] {ag.get('fleet_active_lanes')} Fleet lanes active.")
    non_fleet_total = ag.get("non_fleet_active_count", 0)
    tokens_est = ag.get("non_fleet_est_tokens", 0)
    print(f"  Non-fleet agents: {non_fleet_total} active (~{tokens_est:,} prompt tokens overhead)")
    cats = ag.get("non_fleet_by_category", {})
    eng_count = len(cats.get("engineering", []))
    game_count = len(cats.get("game_dev", []))
    niche_count = len(cats.get("niche_ops", []))
    other_count = len(cats.get("other", []))
    print(f"  - Engineering & QA tools: {eng_count} active (Database Optimizer, MCP Builder, Security, Accessibility, etc.) [Keep recommended]")
    print(f"  - Game Dev & 3D: {game_count} active (Unity, Unreal, Godot, Roblox, Blender, XR) [Archive candidate]")
    print(f"  - Niche & Regional ops: {niche_count} active (WeChat, Feishu) [Archive candidate]")
    print(f"  - Other specialized: {other_count} active")
    if ag.get("archived_total", 0) > 0:
        print(f"  (Archived: {ag.get('archived_total')} agents in ~/.claude/agents-archived/)")

    print(f"[Skills] {sk.get('total_active')} active skills (Core: {len(sk.get('by_category', {}).get('core', []))}, Delegates: {len(sk.get('by_category', {}).get('delegates', []))}, Engineering: {len(sk.get('by_category', {}).get('engineering', []))}, Other: {len(sk.get('by_category', {}).get('other', []))}).")

    if fc.get("full_coverage"):
        print(f"[Fleet Coverage] {fc.get('total_lanes')} lanes active · 100% gateway model coverage ({fc.get('utilized_live_models_count')}/{fc.get('utilized_live_models_count')} models utilized).")
    else:
        print(f"[Fleet Coverage] {fc.get('total_lanes')} lanes active · {fc.get('utilized_live_models_count')} models utilized, {fc.get('unutilized_live_models_count')} unutilized.")


NATIVE_ALIASES = {"default", "opus", "sonnet", "haiku"}


def is_alias(model: object) -> bool:
    """Claude Code aliases are always valid: they resolve against the user's
    login, or through ANTHROPIC_DEFAULT_*_MODEL on a gateway."""
    return isinstance(model, str) and model.removesuffix("[1m]") in NATIVE_ALIASES


def runtime_catalog(home: Path, policy_file: Path | None) -> dict[str, dict]:
    """Live models under the ids settings.json uses (context suffix applied)."""
    from provider_catalog import available_rows
    rows = read_json(home / ".claude" / "cache" / "provider-models-cache.json", {})
    models = rows.get("models") if isinstance(rows, dict) else None
    if not isinstance(models, list):
        return {}
    try:
        policy = load_policy(policy_file) if policy_file else {}
    except CatalogError:
        policy = {}
    return available_rows(models, policy or {"families": []})


def best_live(catalog: dict[str, dict], tier: str) -> str | None:
    """The live model that best fits a capability tier: exact tier first,
    then nearest tier, larger context breaking ties."""
    from provider_catalog import TIER_RANK, model_tier
    if not catalog:
        return None
    ranked = sorted(
        catalog,
        key=lambda model: (
            abs(TIER_RANK[model_tier(model, catalog[model])] - TIER_RANK[tier]),
            -(catalog[model].get("context_length") or 0),
            model,
        ),
    )
    return ranked[0]


def fix_settings(home: Path, advisor_override: str | None = None, target_compaction: int = 800000, policy_file: Path | None = None) -> dict:
    settings_file = home / ".claude" / "settings.json"
    settings = read_json(settings_file, {})
    if not isinstance(settings, dict):
        raise SystemExit(f"settings file not found or invalid: {settings_file}")

    catalog = runtime_catalog(home, policy_file)
    live = set(catalog) | {clean_model_id(model) for model in catalog}

    def stale(model: object) -> bool:
        return isinstance(model, str) and bool(model) and bool(catalog) and not is_alias(model) and model not in live and clean_model_id(model) not in live

    changes = []

    current_advisor = settings.get("advisorModel")
    if advisor_override:
        settings["advisorModel"] = advisor_override
        changes.append(f"advisorModel: {current_advisor} -> {advisor_override}")
    elif stale(current_advisor):
        replacement = best_live(catalog, "deep")
        if replacement:
            settings["advisorModel"] = replacement
            changes.append(f"advisorModel: replaced stale '{current_advisor}' with live '{replacement}'")

    current_model = settings.get("model")
    if stale(current_model):
        replacement = best_live(catalog, "balanced")
        if replacement:
            settings["model"] = replacement
            changes.append(f"model: replaced stale '{current_model}' with live '{replacement}'")

    env = settings.setdefault("env", {})
    if isinstance(env, dict):
        for env_key, tier in (
            ("ANTHROPIC_DEFAULT_OPUS_MODEL", "deep"),
            ("ANTHROPIC_DEFAULT_SONNET_MODEL", "balanced"),
            ("ANTHROPIC_DEFAULT_HAIKU_MODEL", "fast"),
            ("ANTHROPIC_SMALL_FAST_MODEL", "fast"),
        ):
            val = env.get(env_key)
            if stale(val):
                rep = best_live(catalog, tier)
                if rep:
                    env[env_key] = rep
                    changes.append(f"env.{env_key}: replaced stale '{val}' with live '{rep}'")

        if env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW") != str(target_compaction):
            old_val = env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW")
            env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(target_compaction)
            changes.append(f"env.CLAUDE_CODE_AUTO_COMPACT_WINDOW: {old_val} -> {target_compaction}")

    if settings.get("autoCompactWindow") != target_compaction:
        old_val = settings.get("autoCompactWindow")
        settings["autoCompactWindow"] = target_compaction
        changes.append(f"autoCompactWindow: {old_val} -> {target_compaction}")

    if changes:
        atomic_json(settings_file, settings, 0o600)
    return {"changed": bool(changes), "changes": changes}


def archive_agents(home: Path, targets: list[str]) -> dict:
    agents_dir = home / ".claude" / "agents"
    archived_dir = home / ".claude" / "agents-archived"
    if not agents_dir.is_dir():
        return {"archived": 0, "files": []}

    archived_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    normalized_targets = [t.strip().lower() for t in targets if t.strip()]

    moved = []
    for f in sorted(agents_dir.glob("*.md")):
        if f.name.startswith("fleet-"):
            continue
        cat = categorize_agent(f.name)
        should_archive = False
        if "all" in normalized_targets:
            should_archive = True
        elif cat in normalized_targets:
            should_archive = True
        elif f.name.lower() in normalized_targets or f.stem.lower() in normalized_targets:
            should_archive = True

        if should_archive:
            dest = archived_dir / f.name
            f.rename(dest)
            moved.append({"name": f.name, "category": cat})

    return {"archived": len(moved), "files": moved}


def restore_agents(home: Path, targets: list[str]) -> dict:
    agents_dir = home / ".claude" / "agents"
    archived_dir = home / ".claude" / "agents-archived"
    if not archived_dir.is_dir():
        return {"restored": 0, "files": []}

    agents_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    normalized_targets = [t.strip().lower() for t in targets if t.strip()]

    restored = []
    for f in sorted(archived_dir.glob("*.md")):
        cat = categorize_agent(f.name)
        should_restore = False
        if "all" in normalized_targets:
            should_restore = True
        elif cat in normalized_targets:
            should_restore = True
        elif f.name.lower() in normalized_targets or f.stem.lower() in normalized_targets:
            should_restore = True

        if should_restore:
            dest = agents_dir / f.name
            f.rename(dest)
            restored.append({"name": f.name, "category": cat})

    return {"restored": len(restored), "files": restored}


def archive_skills(home: Path, targets: list[str]) -> dict:
    skills_dir = home / ".claude" / "skills"
    archived_dir = home / ".claude" / "skills-archived"
    if not skills_dir.is_dir():
        return {"archived": 0, "files": []}

    archived_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    normalized_targets = [t.strip().lower() for t in targets if t.strip()]

    moved = []
    for s in sorted(skills_dir.iterdir()):
        if s.name == "fleet-setup":
            continue
        cat = categorize_skill(s.name)
        should_archive = False
        if "all" in normalized_targets:
            should_archive = True
        elif cat in normalized_targets:
            should_archive = True
        elif s.name.lower() in normalized_targets:
            should_archive = True

        if should_archive:
            dest = archived_dir / s.name
            if s.is_symlink():
                link_target = os.readlink(s)
                s.unlink()
                (archived_dir / s.name).symlink_to(link_target)
            else:
                s.rename(dest)
            moved.append({"name": s.name, "category": cat})

    return {"archived": len(moved), "files": moved}


def restore_skills(home: Path, targets: list[str]) -> dict:
    skills_dir = home / ".claude" / "skills"
    archived_dir = home / ".claude" / "skills-archived"
    if not archived_dir.is_dir():
        return {"restored": 0, "files": []}

    skills_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    normalized_targets = [t.strip().lower() for t in targets if t.strip()]

    restored = []
    for s in sorted(archived_dir.iterdir()):
        cat = categorize_skill(s.name)
        should_restore = False
        if "all" in normalized_targets:
            should_restore = True
        elif cat in normalized_targets:
            should_restore = True
        elif s.name.lower() in normalized_targets:
            should_restore = True

        if should_restore:
            dest = skills_dir / s.name
            if s.is_symlink():
                link_target = os.readlink(s)
                s.unlink()
                (skills_dir / s.name).symlink_to(link_target)
            else:
                s.rename(dest)
            restored.append({"name": s.name, "category": cat})

    return {"restored": len(restored), "files": restored}


def main() -> int:
    parser = argparse.ArgumentParser(description="Review provider-aware fleet policy")
    parser.add_argument("--home")
    parser.add_argument("--prefix")
    parser.add_argument("--config-home")
    parser.add_argument("--policy")
    parser.add_argument("--decisions", help="JSON decision file for noninteractive setup")
    parser.add_argument("--show", action="store_true", help="print effective policy without changing it")
    parser.add_argument("--reconcile", action="store_true", help="reconcile fleet against live provider models and sync agents")
    parser.add_argument("--audit", action="store_true", help="scan configuration, models, hooks, agents, and skills for health and bloat")
    parser.add_argument("--json", action="store_true", help="output audit results as JSON")
    parser.add_argument("--fix-settings", action="store_true", help="replace stale models in settings.json and optimize compaction")
    parser.add_argument("--advisor", help="override advisorModel when fixing settings")
    parser.add_argument("--compaction", type=int, default=800000, help="target compaction window when fixing settings (default 800000)")
    parser.add_argument("--archive-agents", help="comma-separated agent filenames or categories (engineering, game_dev, niche_ops, other, all) to archive")
    parser.add_argument("--restore-agents", help="comma-separated agent filenames or categories to restore from archive")
    parser.add_argument("--archive-skills", help="comma-separated skill names or categories (core, delegates, engineering, other, all) to archive")
    parser.add_argument("--restore-skills", help="comma-separated skill names or categories to restore from archive")
    parser.add_argument("--prefer", action="append", default=[], metavar="LANE=MODEL[,MODEL]", help="pin a lane's preferred models in order (repeatable); 'LANE=' clears it")
    parser.add_argument("--tier", action="append", default=[], metavar="MODEL=TIER", help="label a model cheap, fast, balanced, or deep (repeatable); 'MODEL=' clears it")
    parser.add_argument("--lock-timeout", type=float, default=4.0, help=argparse.SUPPRESS)
    args = parser.parse_args()
    home = resolved_home(args)
    path = policy_path(args)
    config_home = Path(args.config_home).expanduser().resolve() if args.config_home else Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")).resolve()

    if args.audit:
        res = audit_fleet(home, config_home, path)
        if args.json:
            print(json.dumps(res, ensure_ascii=False, indent=2))
        else:
            print_audit_summary(res)
        return 0

    did_action = False
    if args.fix_settings:
        fix_res = fix_settings(home, advisor_override=args.advisor, target_compaction=args.compaction, policy_file=path)
        if fix_res["changed"]:
            print("Settings updated:")
            for c in fix_res["changes"]:
                print(f"  - {c}")
        else:
            print("Settings already optimal; no changes required.")
        did_action = True

    if args.archive_agents:
        targets = [t.strip() for t in args.archive_agents.split(",") if t.strip()]
        res = archive_agents(home, targets)
        print(f"Archived {res['archived']} agents to {home / '.claude' / 'agents-archived'}.")
        for item in res["files"]:
            print(f"  - {item['name']} ({item['category']})")
        did_action = True

    if args.restore_agents:
        targets = [t.strip() for t in args.restore_agents.split(",") if t.strip()]
        res = restore_agents(home, targets)
        print(f"Restored {res['restored']} agents to {home / '.claude' / 'agents'}.")
        for item in res["files"]:
            print(f"  - {item['name']} ({item['category']})")
        did_action = True

    if args.archive_skills:
        targets = [t.strip() for t in args.archive_skills.split(",") if t.strip()]
        res = archive_skills(home, targets)
        print(f"Archived {res['archived']} skills to {home / '.claude' / 'skills-archived'}.")
        for item in res["files"]:
            print(f"  - {item['name']} ({item['category']})")
        did_action = True

    if args.restore_skills:
        targets = [t.strip() for t in args.restore_skills.split(",") if t.strip()]
        res = restore_skills(home, targets)
        print(f"Restored {res['restored']} skills to {home / '.claude' / 'skills'}.")
        for item in res["files"]:
            print(f"  - {item['name']} ({item['category']})")
        did_action = True

    if args.prefer or args.tier:
        update_fleet_choices(home, config_home, args.prefer, args.tier, args.lock_timeout)
        run_setup_reconciliation_and_sync(home, config_home, path)
        return 0

    if args.reconcile:
        run_setup_reconciliation_and_sync(home, config_home, path)
        return 0

    if did_action and not args.show:
        return 0
    try:
        policy = load_policy(path)
    except CatalogError as exc:
        raise SystemExit(str(exc))
    decisions = parse_decisions(args.decisions)
    if decisions:
        validate_decisions(decisions)
    if decisions.get("proposalDecision"):
        # The interview is never involved on this path, so the lock is held
        # only across the read-validate-write of the proposal file itself.
        fd, lock = acquire_lock(home, timeout=args.lock_timeout)
        if fd is None:
            raise SystemExit(f"another fleet writer holds the lock for {home}; try again")
        try:
            resolve_proposal(home, decisions)
        finally:
            release_lock(fd, lock)
        print(f"Recorded proposal decision in {proposal_path(home)}")
        config_home = Path(args.config_home).expanduser().resolve() if args.config_home else Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")).resolve()
        run_setup_reconciliation_and_sync(home, config_home, path)
        return 0
    if not args.show and not decisions:
        # The interactive interview must never run while holding the shared
        # lock: it blocks on human TTY input for an unbounded time, and
        # holding the lock across that would wedge every other fleet writer
        # (installer, hooks, reconcile, sync) for as long as the operator
        # takes to answer.
        decisions = interview(policy)
    if decisions:
        approved = decisions.get("approvedFamilies")
        if not isinstance(approved, list) or any(not isinstance(value, str) for value in approved):
            raise SystemExit("approvedFamilies must be a list of strings")
        fd, lock = acquire_lock(home, timeout=args.lock_timeout)
        if fd is None:
            raise SystemExit(f"another fleet writer holds the lock for {home}; try again")
        try:
            apply_family_decisions(path, decisions, approved)
        finally:
            release_lock(fd, lock)
        print(f"Saved explicit fleet policy decisions to {path}")
        config_home = Path(args.config_home).expanduser().resolve() if args.config_home else Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")).resolve()
        run_setup_reconciliation_and_sync(home, config_home, path)
    else:
        print(json.dumps(policy, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
