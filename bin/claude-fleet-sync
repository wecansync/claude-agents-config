#!/usr/bin/env bash
# claude-agents-config:managed
set -euo pipefail
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
HOME_OVERRIDE="${CLAUDE_FLEET_HOME:-${HOME:-}}"
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  if [[ "${args[$i]}" == "--home" && $((i+1)) -lt ${#args[@]} ]]; then HOME_OVERRIDE="${args[$((i+1))]}"; fi
done
if [[ -f "$SCRIPT_DIR/../scripts/generate-claude-agents.mjs" ]]; then
  exec node "$SCRIPT_DIR/../scripts/generate-claude-agents.mjs" "$@"
fi
if [[ -z "$HOME_OVERRIDE" ]]; then
  printf '%s\n' 'claude-fleet-sync: HOME is unset; pass --home DIR.' >&2
  exit 2
fi
GENERATOR="$HOME_OVERRIDE/.config/delegate-skills/generate-claude-agents.mjs"
if [[ ! -f "$GENERATOR" ]]; then
  printf 'claude-fleet-sync: generator not found at %s\n' "$GENERATOR" >&2
  exit 1
fi
exec node "$GENERATOR" "$@"
