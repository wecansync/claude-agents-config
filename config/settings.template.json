{
  "env": {
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "800000",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "800000"
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "ask": []
  },
  "model": "default",
  "modelPicker": {
    "options": [
      {
        "model": "default",
        "label": "Default",
        "description": "Claude Code's default model for your account"
      },
      {
        "model": "opus",
        "label": "Opus",
        "description": "Claude Opus through your Claude login"
      },
      {
        "model": "sonnet",
        "label": "Sonnet",
        "description": "Claude Sonnet through your Claude login"
      },
      {
        "model": "haiku",
        "label": "Haiku",
        "description": "Claude Haiku through your Claude login"
      }
    ],
    "replaceBuiltInOptions": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v agent-brain >/dev/null 2>&1; then agent-brain hook tool-use; fi # claude-agents-config:agent-brain",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v agent-brain >/dev/null 2>&1; then agent-brain hook session-end; fi # claude-agents-config:agent-brain",
            "timeout": 10
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__CLAUDE_HOME__/sync-model-context.py\" # claude-agents-config:model-context",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__CLAUDE_HOME__/sync-model-context.py\" --home \"__CLAUDE_HOME__/..\" # claude-agents-config:model-context",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v agent-brain >/dev/null 2>&1; then agent-brain hook session-start; fi # claude-agents-config:agent-brain",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/sync-provider-models.mjs\" --quiet --drift # claude-agents-config:model-sync",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v agent-brain >/dev/null 2>&1; then agent-brain hook stop; fi # claude-agents-config:agent-brain",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v agent-brain >/dev/null 2>&1; then agent-brain hook subagent-stop; fi # claude-agents-config:agent-brain",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v agent-brain >/dev/null 2>&1; then agent-brain hook prompt; fi # claude-agents-config:agent-brain",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__CLAUDE_HOME__/route-to-fleet.py\" # claude-agents-config:route",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "subagentStatusLine": {
    "command": "python3 \"__CLAUDE_HOME__/subagent-statusline.py\" # claude-agents-config:statusline",
    "type": "command"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "autoCompactWindow": 800000,
  "advisorModel": "opus",
  "autoCompactEnabled": true
}
